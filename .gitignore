##==============================================================================
## Official GitHub Visual Studio .gitignore Template
## Customized for C++ Development (Visual Studio 2026)
##==============================================================================

# User-specific items
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# Visual Studio cache directory
.vs/

# C++ objects and intermediate files
*.obj
*.ilk
*.pdb
*.tlog

# Executables and Dynamic Libraries
*.exe

# Output files generated by MSBuild
*.vc.db
*.idb

# CMake build outputs (if you use CMake in VS)
CMakeSettings.json
CMakePresets.json
/CMakeBuild/

# Other temporary and system files
*.tmp
*.log
.DS_Store